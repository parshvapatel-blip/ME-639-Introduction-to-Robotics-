# ROBOTIS OpenMANIPULATOR-X stack for ROS 2 Jazzy (only cloned if not already installed).
repositories:
  robotis/open_manipulator:
    type: git
    url: https://github.com/ROBOTIS-GIT/open_manipulator.git
    version: main
  robotis/dynamixel_hardware_interface:
    type: git
    url: https://github.com/ROBOTIS-GIT/dynamixel_hardware_interface.git
    version: main
  robotis/robotis_interfaces:
    type: git
    url: https://github.com/ROBOTIS-GIT/robotis_interfaces.git
    version: main
